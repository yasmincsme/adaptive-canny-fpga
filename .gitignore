/venv

# Artefatos de simulacao gerados (hex/png de entrada-saida, binarios
# compilados, cabecalhos gerados) -- regeneraveis via scripts/*.py e
# iverilog/xrun. Ver build/README.md.
/build/*
!/build/.gitkeep

# Binarios de simulacao e formas de onda (podem ser gerados por qualquer
# testbench do projeto, em qualquer diretorio de trabalho)
*.vvp
*.vcd
simv
sim_wallace.out
run_sim.sh

# Artefatos do Cadence Xcelium/SimVision
/.simvision
/waves_flex.shm
/waves.shm
/xcelium.d
/sim_export.history
/sim_export.log
/xrun.key
xrun.history
xrun.key
xrun.log
sim_export.history
sim_export.log
.symbolnamelist
.symbolportinfomap
simvision*.diag
waves_window.shm/

# Artefatos de sintese do Genus (regeneraveis via synth/scripts/run_synth.tcl)
/synth/reports/*
!/synth/reports/.gitkeep
/synth/outputs/*
!/synth/outputs/.gitkeep
/synth/logs/*
!/synth/logs/.gitkeep
*.cmd
genus.log
genus.cmd
.genus_history
fv/
